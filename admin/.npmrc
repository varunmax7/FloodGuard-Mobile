# FloodGuard Admin — npm config
# Required because the workspace path contains a space ("FloodGuard-Mobile App")
# which breaks npm's postinstall script spawning on macOS.
# ignore-scripts=false is the default; esbuild is set up manually via:
#   node node_modules/esbuild/install.js

# Increase network timeout for slow connections
fetch-timeout=120000
network-timeout=120000
