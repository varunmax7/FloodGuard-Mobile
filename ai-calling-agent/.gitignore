# ── python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
.python-version.local
.tox/

# ── tooling caches ─────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
reports/
*.prof

# ── env / secrets ──────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.p12
secrets/
