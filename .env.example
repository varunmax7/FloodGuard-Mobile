# ──────────────────────────────────────────────────────────────────────────────
# FloodGuard — Environment Variables Template
# Copy to .env and fill in secrets. Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostGIS) ────────────────────────────────────────────────────────
DATABASE_URL=postgis://floodguard:floodguard@db:5432/floodguard

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# CACHE_URL=redis://redis:6379/1  # separate Redis DB for Django cache (optional)

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to the service-account JSON file (mounted into Docker)
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-credentials.json

# ── Storage (Cloudflare R2 / AWS S3) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=floodguard-media
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto

# ── ECMWF Forecast Ingest ─────────────────────────────────────────────────────
ECMWF_API_KEY=your-ecmwf-open-data-api-key
ECMWF_API_URL=https://data.ecmwf.int/forecasts

# ── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz   # leave empty to disable

# ── Production CORS ───────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://admin.floodguard.app

# ── Admin Dashboard ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json
# VITE_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ── Mobile (dart-define, not in .env — listed here for reference) ─────────────
# flutter run --dart-define=API_BASE_URL=http://localhost:8000
# flutter run --dart-define=SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# ──────────────────────────────────────────────────────────────────────────────
# FloodGuard Andhra MVP (api/ + worker/ + web/) — FLOODGUARD_ANDHRA_MVP.md
# Replaces the Django/Redis/Firebase vars above once backend/ + mobile/ are
# removed (see the implementation plan). Coexists with them until then.
# ──────────────────────────────────────────────────────────────────────────────

# ── api / worker core ─────────────────────────────────────────────────────────
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://floodguard:floodguard@db:5432/floodguard
MIGRATOR_DATABASE_URL=postgresql+psycopg://floodguard:floodguard@db:5432/floodguard
DATA_DIR=/srv/data

# ── Object storage (MinIO stands in for S3 locally; same S3 API) ────────────
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=floodguard
S3_SECRET_KEY=floodguard-minio-dev
PHOTO_BUCKET=fg-andhra-photos-dev
FRAMES_BUCKET=fg-andhra-frames-dev

# ── Free/open data sources (DS-1..DS-5) ──────────────────────────────────────
GFS_BUCKET_URL=https://noaa-gfs-bdp-pds.s3.amazonaws.com
ECMWF_SOURCE=aws
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi/api
WEATHER_BBOX=76,8,92,24
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ── Secrets (dev-only placeholders — rotate for anything real) ──────────────
DEVICE_HASH_KEY=dev-device-hash-key-change-me
IP_HASH_KEY=dev-ip-hash-key-change-me
SESSION_SECRET=dev-session-secret-change-me
ALERT_TEMPLATE_VERSION=2026-10-v1

# ── CORS / public URLs ────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_ALERTS=true
FEATURE_ALERT_SHARING=true
FEATURE_PUSH=false
FEATURE_OFFICIAL_PUSH=false
FEATURE_REPORTS_ENABLED=true
FEATURE_CYCLONE=true
FEATURE_LIVE_MAP_ANIMATION=true
FEATURE_INPUT_CAPTURE_FALLBACK=true

# ── web/ (Vite build-time, public) ───────────────────────────────────────────
VITE_API_BASE=http://localhost:8000/v1
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_FRAMES_BASE=http://localhost:9010/fg-andhra-frames-dev
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
VITE_DEFAULT_LANG=auto
VITE_APP_VERSION=0.1.0-dev
VITE_LINK_APSDMA=https://apsdma.ap.gov.in/
VITE_LINK_OSDMA=https://osdma.org/

# ── admin/ reviewer console ──────────────────────────────────────────────────
VITE_ADMIN_API_BASE=http://localhost:8000/v1/admin
